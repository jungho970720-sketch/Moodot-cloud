# 로그 레벨 (DEBUG | INFO | WARNING | ERROR | CRITICAL), default: INFO
LOG_LEVEL=WARNING

# data provider (rds)
WORKER_DATA_PROVIDER=rds

# event source (polling | sqs)
WORKER_EVENT_SOURCE=polling

# RDS PostgreSQL
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-rds-password
DATABASE_SSL=true
DB_POOL_MAX_SIZE=2

# SQS event source (WORKER_EVENT_SOURCE=sqs 일 때)
SQS_QUEUE_URL=
SQS_REGION=ap-northeast-2
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=5

# 암호화 키
MEMORY_TEXT_ENCRYPTION_KEY=your-memory-text-encryption-key-here

# LLM provider (openai | ollama)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama (LLM_PROVIDER=ollama일 때)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
