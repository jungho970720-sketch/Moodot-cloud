# .env.example
# 인증 (AWS Cognito)
NEXT_PUBLIC_AUTH_PROVIDER=cognito
AUTH_PROVIDER=cognito

NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-2.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-2.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=ap-northeast-2_xxxxxxxxx

# 백엔드 API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000

# 암호화 키 (32-byte raw string, 64-char hex, or base64 that decodes to 32 bytes)
MEMORY_TEXT_ENCRYPTION_KEY=replace-with-memory-text-encryption-key

# RDS PostgreSQL
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-rds-password
DATABASE_SSL=true

# AWS S3 이미지 저장
S3_BUCKET=your-s3-bucket-name
S3_REGION=ap-northeast-2

# AWS SQS AI Worker 이벤트
# 비워두면 기록 생성 후 SQS 전송을 건너뜁니다.
AI_EVENT_QUEUE_URL=
SQS_REGION=ap-northeast-2

# 로그 레벨 (DEBUG | INFO | WARNING | ERROR | CRITICAL)
NEXT_PUBLIC_LOG_LEVEL=warning
LOG_LEVEL=WARNING
