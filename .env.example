# .env.example
NEXT_PUBLIC_AUTH_PROVIDER=supabase
AUTH_PROVIDER=supabase

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Cognito 전환 초기에는 백엔드가 Supabase DB를 임시로 계속 읽기 위해 필요합니다.
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# AWS Cognito Hosted UI (NEXT_PUBLIC_AUTH_PROVIDER=cognito일 때 사용)
NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-2.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-2.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=ap-northeast-2_xxxxxxxxx

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
# 32-byte raw string, 64-char hex, or base64 that decodes to 32 bytes
MEMORY_TEXT_ENCRYPTION_KEY=replace-with-memory-text-encryption-key

# AWS S3 image storage. If these are set, backend uploads memory images to S3.
# If omitted, backend falls back to the existing Supabase Storage flow.
S3_BUCKET=your-s3-bucket-name
S3_REGION=ap-northeast-2

# log level (DEBUG | INFO | WARNING | ERROR | CRITICAL), default: INFO
# Next.js (NEXT_PUBLIC_ prefix required for client-side access)
NEXT_PUBLIC_LOG_LEVEL=warning

# service/
# log level (DEBUG | INFO | WARNING | ERROR | CRITICAL), default: INFO
LOG_LEVEL=WARNING
